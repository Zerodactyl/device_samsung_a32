type hal_drk_default, domain, halserverdomain, halclientdomain, hal_weaver_client;
type hal_drk_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_drk_default)

allow hal_drk_default hal_drk_hwservice:hwservice_manager { add find};
allow hal_drk_default hidl_base_hwservice:hwservice_manager add;
